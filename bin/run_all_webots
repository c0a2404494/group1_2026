#!/bin/bash

# 使用例："run_all_webots --world my_world.wbt --map /path/to/custom_map.yaml"
# デフォルトはローカルモード。サーバー(vglrun)で使う場合は --server または --mode server を指定すること

MODE="local"
WORLD_FILE="sim_house.wbt"
MAP_FILE="$HOME/practice_ws/maps/sim_house_world.yaml"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --mode)
      MODE="$2"
      shift 2
      ;;
    --server)
      MODE="server"
      shift
      ;;
    --world)
      WORLD_FILE="$2"
      shift 2
      ;;
    --map)
      MAP_FILE="$2"
      shift 2
      ;;
    -h|--help)
      echo "Usage: $0 [--server | --mode local|server] [--world WORLD_FILE] [--map MAP_FILE]"
      echo "  default mode: local"
      exit 0
      ;;
    *)
      echo "Unknown option: $1"
      exit 1
      ;;
  esac
done

case "$MODE" in
  local)
    echo "local mode"
    VGL=""
    ;;
  server)
    echo "server mode"
    VGL="vglrun"
    ;;
  *)
    echo "Invalid mode: $MODE (use local or server)"
    exit 1
    ;;
esac

source ~/turtlebot3_ws/install/setup.bash
source ~/webots_ws/install/setup.bash

$VGL ros2 launch turtlebot3_lime_webots robot_launch.py world:="$WORLD_FILE" &
sleep 5
$VGL ros2 launch turtlebot3_lime_moveit_config servo.launch.py use_sim:=true &
sleep 1
$VGL ros2 launch turtlebot3_lime_bringup moveit_navigation_use_sim_time.launch.py map_yaml_file:="$MAP_FILE"
